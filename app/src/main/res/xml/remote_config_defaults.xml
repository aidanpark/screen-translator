<?xml version="1.0" encoding="utf-8"?>
<!-- START xml_defaults -->
<defaultsMap>


    <!--
        1.18.07 ~
        서비스 제공 여부. true: 서비스 제공, false: 서비스 제공하지 않음.
            {
                "default": true,
                "KR": true
            }
    -->
    <entry>
        <key>service_available</key>
        <value>
            {
                "default": true
            }
        </value>
    </entry>

    <!--
        1.99 ~ 최신 앱 버전 코드
    -->
    <entry>
        <key>latest_version_code</key>
        <value>19000</value>
    </entry>

    <!--
        1.99 ~ 강제 업데이트 버전 코드
    -->
    <entry>
        <key>force_update_version_code</key>
        <value>0</value>
    </entry>

    <!--
        2.4.0 ~ 무료체험 광고 아이디
    -->
    <entry>
        <key>ad_unit_id</key>
        <value>ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx</value>
    </entry>

    <!--
        2.7.2 ~ AI 번역 엔진별 모델 후보. 설정에서 이 중 하나를 고른다.
        2.6.0~2.7.1 의 openai_translate_models / gemini_translate_models /
        claude_translate_models 세 항목을 하나로 합친 것이다.
        (구 항목은 2.7.1 이하 사용자가 아직 읽으므로 콘솔에서 바로 지우지 말 것)

        목록의 앞에 있는 모델을 먼저 쓰고(설정의 기본값), 실패하면 뒤로 넘어간다.
        사용자가 자기 API 키를 쓰므로 싼 것을 앞에 둔다. 2026-09-20 각 사 문서 기준으로 갱신.

        openai  gpt-5.6-luna 가 현행 라인업 중 가장 싸다($0.20/입력 MTok). gpt-4o-mini 는
                현행 라인업에서 빠졌지만 아직 폐기 고지는 없어, 신모델 접근이 없는 계정용
                하위 호환으로 맨 뒤에 남긴다. gpt-4o 는 뺐다(gpt-4o-mini 가 더 싸고 같은 세대).
        gemini  롤링 별칭(-latest)을 앞에 두어 모델이 은퇴해도 깨지지 않게 한다.
                flash-lite 가 앞인 이유: 무료 등급 한도가 더 높아 429 가 덜 나고 응답이 빠르다.
                맨 뒤 고정 ID 는 gemini-2.5-flash-lite → gemini-3.5-flash-lite 로 올렸다.
        claude  2026-09-29 사용자 결정: Sonnet 5.5 → Sonnet 5 → Opus 5.5 (첫째가 기본값).
                Claude 는 원문이 auto 거나 읽을 엔진이 없는 언어면 화면 조각을 읽고 번역하는데
                (vision-engine-design §25), 같은 표본 126건에서 맞은 수는 Opus 5 123 > Opus 5.5 122 >
                Sonnet 5.5 121 > Fable 5.1 119 > Sonnet 5 117, Haiku 4.5 는 141건 중 40(조지아·크메르·
                암하라·미얀마를 지어냈다). Sonnet 5.5 가 가장 빠르다(중앙값 2.3초). Sonnet 5 는 레거시다 —
                은퇴 공지가 나오면 이 항목을 원격으로 고친다. Haiku 4.5 은퇴(2026-10-15 이후) 문제도 사라진다.
    -->
    <entry>
        <key>translate_models</key>
        <value>
            {
                "openai": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-4o-mini"],
                "gemini": ["gemini-flash-lite-latest", "gemini-flash-latest", "gemini-3.5-flash-lite"],
                "claude": ["claude-sonnet-5-5", "claude-sonnet-5", "claude-opus-5-5"]
            }
        </value>
    </entry>


    <!--
        2.7.2 ~ 광고 게이트 동작 정책.

        failure_threshold / backoff_hours
            광고 로드가 연속 N회 실패하면 그 시간 동안 게이트를 열지 않는다.
            러시아는 광고 게재가 중단돼 일치율 0%, 이란은 제재로 요청 자체가 나가지 않는다.
            이런 사용자에게 게이트는 수익 없이 5분마다 창을 띄우고 최대 15초를 기다리게 할 뿐이다.
            국가 목록이 아니라 실제 로드 결과로 판단하므로 다른 지역이 막혀도 자동 대응된다.
            억제가 만료되면 다시 광고를 시도한다(영구 차단 아님). 0 이하면 기능이 꺼진다.

        skip_cooldown_seconds
            사용자가 광고를 스킵한 뒤 게이트를 다시 열지 않는 시간. 0 이면 즉시 재게이트.
            이 값의 손익은 eCPM 이 높은 국가(일본·미국·한국)에 집중되므로,
            배포 후 노출수를 보고 앱 릴리스 없이 조정한다.
    -->
    <entry>
        <key>ad_gate_failure_backoff</key>
        <value>
            {
                "failure_threshold": 3,
                "backoff_hours": 24,
                "skip_cooldown_seconds": 60
            }
        </value>
    </entry>

    <!--
        2.8.0 ~ PP-OCRv5 끄기 스위치 (.docs/vision-engine-design.md §19).

        paddle_ocr_enabled
            false 면 PP-OCRv5 를 쓰지 않고 지정 언어·auto 모두 ML Kit 으로 읽는다. 아랍·동슬라브 키릴·태국 문자는
            ML Kit 라틴 인식기가 읽게 되어 알아볼 수 없는 글자가 나온다. Claude 이미지 번역(§25)은 읽을 엔진이 없는 언어만
            보내므로 이 문자권의 Claude 사용자도 마찬가지다 — 끄면 이 문자권 번역이 사실상 멈추니, PP-OCRv5 로 인한
            크래시·심한 지연처럼 더 큰 문제일 때만 끈다. 끄면 auto 의 지원되지 않는 문자권 관문(성능 P7)도 돌지 않는다.
        paddle_ocr_auto_enabled
            false 면 auto 에서 PP-OCRv5 표본을 돌리지 않는다(언어를 지정한 경우는 계속 쓴다).
            auto 는 모든 화면에서 표본을 돌리므로, 지연·발열·크래시가 auto 에서 보이면 이것부터 끈다.
    -->
    <entry>
        <key>paddle_ocr_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>paddle_ocr_auto_enabled</key>
        <value>true</value>
    </entry>

    <!--
        claude_image_enabled
            false 면 Claude 도 OCR 글을 번역한다 — 화면을 잘라 보내지 않는다(.docs/vision-engine-design.md §25).
            켜져 있으면 Claude 에서 원문 언어가 auto 이거나 화면 글자를 읽을 엔진이 없는 언어(25개)일 때 이미지를 보낸다.
            끄면 그 25개 언어는 원문으로 쓸 수 없다. 이미지 요청의 비용·지연 문제가 보이면 끈다.
    -->
    <entry>
        <key>claude_image_enabled</key>
        <value>true</value>
    </entry>

</defaultsMap>
    <!-- END xml_defaults -->
